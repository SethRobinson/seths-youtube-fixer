{
  "name": "seths-youtube-fixer",
  "version": "0.1.3",
  "private": true,
  "description": "Power-user controls for YouTube: Less like this, Don't recommend channel, forget recent activity, and comment search.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:safari": "node scripts/build.mjs --safari",
    "watch:safari": "node scripts/build.mjs --safari --watch",
    "safari:build": "node scripts/safari-remote.mjs",
    "safari:check": "node scripts/safari-remote.mjs --unsigned",
    "safari:install": "node scripts/safari-remote.mjs --install",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test scripts/test-members-only-unit.mjs scripts/test-safari-unit.mjs",
    "setup": "node scripts/setup.mjs",
    "reload": "node scripts/build.mjs && node scripts/reload.mjs",
    "drive": "node scripts/build.mjs && node scripts/reload.mjs && node scripts/drive.mjs",
    "pretest": "node scripts/build.mjs && node scripts/reload.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "*",
    "@types/node": "^22",
    "esbuild": "^0.24.0",
    "linkedom": "^0.18.12",
    "typescript": "^5.6.0"
  }
}
